# Global
VEL_HOME=~/.vel
VEL_CONFIG=./vel.config.example.yaml
VEL_LOG_LEVEL=info

# Glasses
VEL_GLASSES_PROVIDER=mock
VEL_GLASSES_WORKER_IDLE_TTL_SECONDS=600
VEL_LOCATEANYTHING_REPO=/path/to/NVlabs/Eagle/Embodied
VEL_LOCATEANYTHING_MODEL=nvidia/LocateAnything-3B
VEL_LOCATEANYTHING_PYTHON=python
VEL_LOCATEANYTHING_DEVICE=auto
VEL_LOCATEANYTHING_ATTN_IMPLEMENTATION=sdpa

# Privacy, later
VEL_PRIVACY_ENABLED=false
VEL_PRIVACY_REQUIRE_REVIEW=true
