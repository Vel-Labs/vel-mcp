{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VEL Glasses Eval Task",
  "type": "object",
  "required": [
    "id",
    "taskType",
    "input",
    "expected"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "taskType": {
      "enum": [
        "locate",
        "ocr",
        "inspect",
        "compare",
        "video"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input": {
      "type": "object"
    },
    "expected": {
      "type": "object"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}