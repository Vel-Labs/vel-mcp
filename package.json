{
  "name": "vel-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint packages apps evals --ext .ts",
    "verify": "node scripts/verify-scaffold.mjs && pnpm build && pnpm lint && pnpm test && pnpm typecheck",
    "setup:mcp": "node scripts/setup-mcp.mjs mcp",
    "setup:codex": "node scripts/setup-mcp.mjs codex",
    "setup:opencode": "node scripts/setup-mcp.mjs opencode",
    "dev:glasses": "pnpm --filter @vel/glasses-mcp dev",
    "smoke:glasses": "bash scripts/smoke-glasses.sh",
    "eval:glasses": "pnpm --filter @vel/glasses-evals eval:mock",
    "eval:locate-anything-smoke": "pnpm --filter @vel/glasses-evals eval:locate-anything-smoke",
    "eval:locate-anything-quality": "pnpm --filter @vel/glasses-evals eval:locate-anything-quality"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "eslint": "^10.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^2.1.0"
  }
}
